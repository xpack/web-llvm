    <templateparamlist>
      <param>
        <type>typename <ref refid="class_t" kindref="compound">T</ref></type>
      </param>
      <param>
        <type>typename <ref refid="namespacellvm_1afdccf3ff7a8dfaa084b07c1fb417bbe2a2faec1f9f8cc7f8f40d521c4dd574f49" kindref="member">Enable</ref></type>
        <defval>void</defval>
      </param>
