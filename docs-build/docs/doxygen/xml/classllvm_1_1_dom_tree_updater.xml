      <memberdef kind="function" id="classllvm_1_1_dom_tree_updater_1aa22a66bf381f2b0a994b4e00cca5eac4" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void llvm::DomTreeUpdater::callbackDeleteBB</definition>
        <argsstring>(BasicBlock *DelBB, std::function&lt; void(BasicBlock *)&gt; Callback)</argsstring>
        <name>callbackDeleteBB</name>
        <qualifiedname>llvm::DomTreeUpdater::callbackDeleteBB</qualifiedname>
        <param>
          <type><ref refid="classllvm_1_1_basic_block" kindref="compound">BasicBlock</ref> *</type>
          <declname>DelBB</declname>
        </param>
        <param>
          <type>std::function&lt; void(<ref refid="classllvm_1_1_basic_block" kindref="compound">BasicBlock</ref> *)&gt;</type>
          <declname>Callback</declname>
