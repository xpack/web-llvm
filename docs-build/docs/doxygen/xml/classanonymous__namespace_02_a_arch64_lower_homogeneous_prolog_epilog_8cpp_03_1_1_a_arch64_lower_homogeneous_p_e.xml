        <name>lowerProlog</name>
        <qualifiedname>anonymous_namespace{AArch64LowerHomogeneousPrologEpilog.cpp}::AArch64LowerHomogeneousPE::lowerProlog</qualifiedname>
        <param>
          <type><ref refid="classllvm_1_1_machine_basic_block" kindref="compound">MachineBasicBlock</ref> &amp;</type>
          <declname>MBB</declname>
        </param>
        <param>
          <type><ref refid="classllvm_1_1_machine_basic_block_1ae34c996b58df9b9ce6695a0c8b70c533" kindref="member">MachineBasicBlock::iterator</ref></type>
