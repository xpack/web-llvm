      <memberdef kind="variable" id="classllvm_1_1mca_1_1_resource_state_1aab7ef0fd3a8f6ff66cd5bf8e70b009bf" prot="private" static="no" mutable="no">
        <type><ref refid="_a_arch64_promote_constant_8cpp_1a90f8350fecae261c25be85d38b451bff" kindref="member">const</ref> int</type>
        <definition>const int llvm::mca::ResourceState::BufferSize</definition>
        <argsstring></argsstring>
        <name>BufferSize</name>
        <qualifiedname>llvm::mca::ResourceState::BufferSize</qualifiedname>
        <briefdescription>
<para>Buffered resources will have this field set to a positive number different than zero. </para>
        </briefdescription>
        <detaileddescription>
<para>A buffered resource behaves like a reservation station implementing its own buffer for out-of-order execution.</para>
<para>A BufferSize of 1 is used by scheduler resources that force in-order execution.</para>
<para>A BufferSize of 0 is used to model in-order issue/dispatch resources. Since in-order issue/dispatch resources don&apos;t implement buffers, dispatch events coincide with issue events. Also, no other instruction ca be dispatched/issue while this resource is in use. Only when all the &quot;resource cycles&quot; are consumed (after the issue event), a new instruction ca be dispatched. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/llvm/MCA/HardwareUnits/ResourceManager.h" line="193" column="13" bodyfile="include/llvm/MCA/HardwareUnits/ResourceManager.h" bodystart="193" bodyend="-1"/>
      </memberdef>
