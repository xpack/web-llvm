</simplesect>
<simplesect kind="post"><para><ref refid="classllvm_1_1_reg_bank_select_1_1_insert_point_1a4acd081c2e07b76bc2d5a5b5144ea937" kindref="member">getInsertMBBImpl()</ref> returns a valid basic block. </para>
</simplesect>
<simplesect kind="post"><para><ref refid="classllvm_1_1_reg_bank_select_1_1_instr_insert_point_1a8bf99289cea710aff85335a6cc7aefb6" kindref="member">isSplit()</ref> == false ; no more splitting should be required. </para>
</simplesect>
</para>
