        <name>clearsSuperRegisters</name>
        <qualifiedname>anonymous_namespace{AArch64MCTargetDesc.cpp}::AArch64MCInstrAnalysis::clearsSuperRegisters</qualifiedname>
        <reimplements refid="classllvm_1_1_m_c_instr_analysis_1ac8a4a891bdc2466ae10fe03a0a44bb81">clearsSuperRegisters</reimplements>
        <param>
          <type><ref refid="_a_arch64_promote_constant_8cpp_1a90f8350fecae261c25be85d38b451bff" kindref="member">const</ref> <ref refid="classllvm_1_1_m_c_register_info" kindref="compound">MCRegisterInfo</ref> &amp;</type>
