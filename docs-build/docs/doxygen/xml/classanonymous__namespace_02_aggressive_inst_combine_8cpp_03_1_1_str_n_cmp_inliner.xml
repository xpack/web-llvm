      <memberdef kind="function" id="classanonymous__namespace_02_aggressive_inst_combine_8cpp_03_1_1_str_n_cmp_inliner_1ac9d71bcb73b24374e675d3ac3b8f5e8b" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
