<para><programlisting><codeline><highlight class="normal">ret<sp/>=<sp/><ref refid="namespacellvm_1_1_scaled_numbers_1a0651aa0a52c69c4fe12cf730e7ed65ab" kindref="member">compare</ref>(s1,<sp/>s2,<sp/><ref refid="regcomp_8c_1a0240ac851181b84ac374872dc5434ee4" kindref="member">N</ref>)</highlight></codeline>
</programlisting></para>
<para>into</para>
<para><programlisting><codeline><highlight class="normal">ret<sp/>=<sp/>(int)s1[0]<sp/>-<sp/>(</highlight><highlight class="keywordtype">int</highlight><highlight class="normal">)s2[0]</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(ret<sp/>!=<sp/>0)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="keywordflow">goto</highlight><highlight class="normal"><sp/><ref refid="namespacellvm_1_1_a_arch64_c_c_1abfa1f7dce576430da99eed57807c7f28a191e89dbc4939ebd0b572cae44aac05f" kindref="member">NE</ref></highlight></codeline>
<codeline><highlight class="normal">...</highlight></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>(int)s1[<ref refid="regcomp_8c_1a0240ac851181b84ac374872dc5434ee4" kindref="member">N</ref>-2]<sp/>-<sp/>(</highlight><highlight class="keywordtype">int</highlight><highlight class="normal">)s2[<ref refid="regcomp_8c_1a0240ac851181b84ac374872dc5434ee4" kindref="member">N</ref>-2]</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(ret<sp/>!=<sp/>0)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/></highlight><highlight class="keywordflow">goto</highlight><highlight class="normal"><sp/><ref refid="namespacellvm_1_1_a_arch64_c_c_1abfa1f7dce576430da99eed57807c7f28a191e89dbc4939ebd0b572cae44aac05f" kindref="member">NE</ref></highlight></codeline>
<codeline><highlight class="normal">ret<sp/>=<sp/>(int)s1[<ref refid="regcomp_8c_1a0240ac851181b84ac374872dc5434ee4" kindref="member">N</ref>-1]<sp/>-<sp/>(</highlight><highlight class="keywordtype">int</highlight><highlight class="normal">)s2[<ref refid="regcomp_8c_1a0240ac851181b84ac374872dc5434ee4" kindref="member">N</ref>-1]</highlight></codeline>
