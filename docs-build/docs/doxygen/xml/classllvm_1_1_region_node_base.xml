        <type><ref refid="classllvm_1_1_pointer_int_pair" kindref="compound">PointerIntPair</ref>&lt; <ref refid="classllvm_1_1_region_node_base_1a99eb170338216f790c45a3657d45ed42" kindref="member">BlockT</ref> *, 1, <ref refid="classbool" kindref="compound">bool</ref> &gt;</type>
