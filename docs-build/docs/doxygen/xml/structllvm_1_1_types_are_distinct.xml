    <compoundname>llvm::TypesAreDistinct</compoundname>
    <basecompoundref prot="public" virt="non-virtual">std::integral_constant&lt; bool, detail::TypesAreDistinct&lt; Ts... &gt;::value &gt;</basecompoundref>
    <includes refid="_s_t_l_extras_8h" local="yes">llvm/ADT/STLExtras.h</includes>
