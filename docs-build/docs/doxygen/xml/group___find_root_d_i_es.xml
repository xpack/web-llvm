        <definition>void llvm::DWARFLinker::lookForDIEsToKeep</definition>
        <argsstring>(AddressesMap &amp;RelocMgr, const UnitListTy &amp;Units, const DWARFDie &amp;DIE, const DWARFFile &amp;File, CompileUnit &amp;CU, unsigned Flags)</argsstring>
        <name>lookForDIEsToKeep</name>
