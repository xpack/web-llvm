        <param>
          <type>std::forward_list&lt; <ref refid="structanonymous__namespace_02_loop_load_elimination_8cpp_03_1_1_store_to_load_forwarding_candidate" kindref="compound">StoreToLoadForwardingCandidate</ref> &gt; &amp;</type>
