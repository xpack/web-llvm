      <memberdef kind="function" id="classanonymous__namespace_02_inline_spiller_8cpp_03_1_1_hoist_spill_helper_1a597bb5d7ef9a22f44dbe867d8eaa7fd6" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
