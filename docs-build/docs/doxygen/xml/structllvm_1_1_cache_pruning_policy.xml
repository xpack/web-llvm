      <memberdef kind="variable" id="structllvm_1_1_cache_pruning_policy_1a4e4e128e83c615ca4ed425980b41e64f" prot="public" static="no" mutable="no">
        <type>std::chrono::seconds</type>
        <definition>std::chrono::seconds llvm::CachePruningPolicy::Expiration</definition>
        <argsstring></argsstring>
        <name>Expiration</name>
        <qualifiedname>llvm::CachePruningPolicy::Expiration</qualifiedname>
        <initializer>= std::chrono::hours(7 * 24)</initializer>
        <briefdescription>
<para>The expiration for a file. </para>
        </briefdescription>
        <detaileddescription>
<para>When a file hasn&apos;t been accessed for Expiration seconds, it is removed from the cache. A value of 0 disables the expiration-based pruning. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
