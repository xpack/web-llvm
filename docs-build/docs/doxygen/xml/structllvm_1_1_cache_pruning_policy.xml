      <memberdef kind="variable" id="structllvm_1_1_cache_pruning_policy_1ac13a6c169c6b44529d9f6bae76c8b4ed" prot="public" static="no" mutable="no">
        <type><ref refid="classunsigned" kindref="compound">unsigned</ref></type>
        <definition>unsigned llvm::CachePruningPolicy::MaxSizePercentageOfAvailableSpace</definition>
        <argsstring></argsstring>
        <name>MaxSizePercentageOfAvailableSpace</name>
        <qualifiedname>llvm::CachePruningPolicy::MaxSizePercentageOfAvailableSpace</qualifiedname>
        <initializer>= 75</initializer>
        <briefdescription>
<para>The maximum size for the cache directory, in terms of percentage of the available space on the disk. </para>
        </briefdescription>
        <detaileddescription>
<para>Set to 100 to indicate no limit, 50 to indicate that the cache size will not be left over half the available disk space. A value over 100 will be reduced to 100. A value of 0 disables the percentage size-based pruning. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
