      <memberdef kind="variable" id="structllvm_1_1_cache_pruning_policy_1a26f65d4efd088dd6f035a970ef350628" prot="public" static="no" mutable="no">
        <type>std::optional&lt; std::chrono::seconds &gt;</type>
        <definition>std::optional&lt;std::chrono::seconds&gt; llvm::CachePruningPolicy::Interval</definition>
        <argsstring></argsstring>
        <name>Interval</name>
        <qualifiedname>llvm::CachePruningPolicy::Interval</qualifiedname>
        <initializer>= std::chrono::seconds(1200)</initializer>
        <briefdescription>
<para>The pruning interval. </para>
        </briefdescription>
        <detaileddescription>
<para>This is intended to be used to avoid scanning the directory too often. It does not impact the decision of which file to prune. A value of 0 forces the scan to occur. A value of std::nullopt disables pruning. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
