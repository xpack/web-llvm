    <sectiondef kind="protected-func">
      <memberdef kind="function" id="structllvm_1_1_d_o_t_graph_traits_viewer_1a60e99be77348c5e34276c770b2dd68aa" prot="protected" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
