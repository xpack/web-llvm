          <type><ref refid="_a_arch64_promote_constant_8cpp_1a90f8350fecae261c25be85d38b451bff" kindref="member">const</ref> <ref refid="classllvm_1_1sampleprof_1_1_function_samples" kindref="compound">FunctionSamples</ref> *</type>
