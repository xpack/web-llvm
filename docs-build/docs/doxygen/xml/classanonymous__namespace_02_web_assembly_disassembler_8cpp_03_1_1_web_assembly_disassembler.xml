        <qualifiedname>anonymous_namespace{WebAssemblyDisassembler.cpp}::WebAssemblyDisassembler::onSymbolStart</qualifiedname>
        <reimplements refid="classllvm_1_1_m_c_disassembler_1a433d519ca0c3f0c4fd434168aded199f">onSymbolStart</reimplements>
        <param>
          <type><ref refid="structllvm_1_1_symbol_info_ty" kindref="compound">SymbolInfoTy</ref> &amp;</type>
          <declname>Symbol</declname>
        </param>
        <param>
          <type><ref refid="classuint64__t" kindref="compound">uint64_t</ref> &amp;</type>
          <declname>Size</declname>
        </param>
        <param>
          <type><ref refid="classllvm_1_1_array_ref" kindref="compound">ArrayRef</ref>&lt; <ref refid="classuint8__t" kindref="compound">uint8_t</ref> &gt;</type>
          <declname>Bytes</declname>
