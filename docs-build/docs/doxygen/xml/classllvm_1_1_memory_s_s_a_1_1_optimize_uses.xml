        </param>
        <param>
          <type><ref refid="classllvm_1_1_dense_map" kindref="compound">DenseMap</ref>&lt; MemoryLocOrCall, MemlocStackInfo &gt; &amp;</type>
          <defname>LocStackInfo</defname>
