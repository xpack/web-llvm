  <compounddef id="structllvm_1_1hashing_1_1detail_1_1is__hashable__data" kind="struct" language="C++" prot="public">
    <compoundname>llvm::hashing::detail::is_hashable_data</compoundname>
    <basecompoundref prot="public" virt="non-virtual">std::integral_constant&lt; bool,((is_integral_or_enum&lt; T &gt;::value||std::is_pointer&lt; T &gt;::value) &amp;&amp;64 % sizeof(T)==0)&gt;</basecompoundref>
