        <name>tryAddingSymbolicOperand</name>
        <qualifiedname>llvm::AMDGPUSymbolizer::tryAddingSymbolicOperand</qualifiedname>
        <reimplements refid="classllvm_1_1_m_c_symbolizer_1adac4188cce487f7706a299575df4f684">tryAddingSymbolicOperand</reimplements>
        <param>
          <type><ref refid="classllvm_1_1_m_c_inst" kindref="compound">MCInst</ref> &amp;</type>
          <declname>Inst</declname>
        </param>
        <param>
          <type><ref refid="classllvm_1_1raw__ostream" kindref="compound">raw_ostream</ref> &amp;</type>
