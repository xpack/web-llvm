    <sectiondef kind="public-type">
      <memberdef kind="enum" id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3" prot="public" static="no" strong="no">
        <type></type>
        <name>JTEntryKind</name>
        <qualifiedname>llvm::MachineJumpTableInfo::JTEntryKind</qualifiedname>
        <enumvalue id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3ab0c4687afc1a6858d37711a814f8f5b3" prot="public">
          <name>EK_BlockAddress</name>
          <briefdescription>
<para>EK_BlockAddress - Each entry is a plain address of block, e.g.: .word LBB123. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3aba174e822c60ce5af99bdb57ab3ec640" prot="public">
          <name>EK_GPRel64BlockAddress</name>
          <briefdescription>
<para>EK_GPRel64BlockAddress - Each entry is an address of block, encoded with a relocation as gp-relative, e.g.: .gpdword LBB123. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3a0145ef8496d090993849ec0d7ca947f7" prot="public">
          <name>EK_GPRel32BlockAddress</name>
          <briefdescription>
<para>EK_GPRel32BlockAddress - Each entry is an address of block, encoded with a relocation as gp-relative, e.g.: .gprel32 LBB123. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3a6e05991949952d4e85600b0868dcd803" prot="public">
          <name>EK_LabelDifference32</name>
          <briefdescription>
<para>EK_LabelDifference32 - Each entry is the address of the block minus the address of the jump table. </para>
          </briefdescription>
          <detaileddescription>
<para>This is used for PIC jump tables where gprel32 is not supported. e.g.: .word LBB123 - LJTI1_2 If the .set directive is supported, this is emitted as: .set L4_5_set_123, LBB123 - LJTI1_2 .word L4_5_set_123 </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3a9f3683fb3f6e9f802d817742cf08a1a5" prot="public">
          <name>EK_LabelDifference64</name>
          <briefdescription>
<para>EK_LabelDifference64 - Each entry is the address of the block minus the address of the jump table. </para>
          </briefdescription>
          <detaileddescription>
<para>This is used for PIC jump tables where gprel64 is not supported. e.g.: .quad LBB123 - LJTI1_2 </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3a0c8edab8f0150200196e0c217e343058" prot="public">
          <name>EK_Inline</name>
          <briefdescription>
<para>EK_Inline - Jump table entries are emitted inline at their point of use. </para>
          </briefdescription>
          <detaileddescription>
<para>It is the responsibility of the target to emit the entries. </para>
          </detaileddescription>
        </enumvalue>
        <enumvalue id="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3a9e655fb625d744f96e03aed78ca85707" prot="public">
          <name>EK_Custom32</name>
          <briefdescription>
<para>EK_Custom32 - Each entry is a 32-bit value that is custom lowered by the <ref refid="classllvm_1_1_target_lowering_1acf30ced2ac2474a0dd5af2e3417c7b7d" kindref="member">TargetLowering::LowerCustomJumpTableEntry</ref> hook. </para>
          </briefdescription>
          <detaileddescription>
          </detaileddescription>
        </enumvalue>
        <briefdescription>
<para><ref refid="classllvm_1_1_machine_jump_table_info_1aaa21facdbb167f7c33d21907b8e5b9d3" kindref="member">JTEntryKind</ref> - This enum indicates how each entry of the jump table is represented and emitted. </para>
        </briefdescription>
        <detaileddescription>
        </detaileddescription>
