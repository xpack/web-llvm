        <type>std::function&lt; void(<ref refid="_a_arch64_promote_constant_8cpp_1a90f8350fecae261c25be85d38b451bff" kindref="member">const</ref> <ref refid="structllvm_1_1_attributor_1_1_argument_replacement_info" kindref="compound">ArgumentReplacementInfo</ref> &amp;, <ref refid="classllvm_1_1_abstract_call_site" kindref="compound">AbstractCallSite</ref>, <ref refid="classllvm_1_1_small_vector_impl" kindref="compound">SmallVectorImpl</ref>&lt; <ref refid="classllvm_1_1_value" kindref="compound">Value</ref> * &gt; &amp;)&gt;</type>
