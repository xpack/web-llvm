  <compounddef id="classllvm_1_1function__ref" kind="class" language="C++" prot="public">
    <compoundname>llvm::function_ref</compoundname>
    <templateparamlist>
      <param>
        <type>typename Fn</type>
      </param>
    </templateparamlist>
    <briefdescription>
<para>An efficient, type-erasing, non-owning reference to a callable. </para>
    </briefdescription>
    <detaileddescription>
<para>This is intended for use as the type of a function parameter that is not used after the function in question returns.</para>
<para>This class does not own the callable, so it is not in general safe to store a <ref refid="classllvm_1_1function__ref" kindref="compound">function_ref</ref>. </para>
    </detaileddescription>
