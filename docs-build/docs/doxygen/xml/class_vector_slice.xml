      <memberdef kind="function" id="class_vector_slice_1aef12c412e54fb31aa597199eadc0e866" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type><ref refid="classllvm_1_1_value" kindref="compound">Value</ref> *</type>
        <definition>Value * VectorSlice::getSlicedVal</definition>
        <argsstring>(BasicBlock *BB, Value *Inc, StringRef NewValName)</argsstring>
        <name>getSlicedVal</name>
        <qualifiedname>VectorSlice::getSlicedVal</qualifiedname>
        <param>
          <type><ref refid="classllvm_1_1_basic_block" kindref="compound">BasicBlock</ref> *</type>
          <declname>BB</declname>
        </param>
