        <param>
          <type><ref refid="_a_arch64_promote_constant_8cpp_1a90f8350fecae261c25be85d38b451bff" kindref="member">const</ref> <ref refid="structllvm_1_1objcopy_1_1wasm_1_1_section" kindref="compound">Section</ref> &amp;</type>
