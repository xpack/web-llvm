        <definition>Expected&lt; LineEntry &gt; LineTable::lookup</definition>
        <argsstring>(DataExtractor &amp;Data, uint64_t BaseAddr, uint64_t Addr)</argsstring>
        <name>lookup</name>
        <qualifiedname>llvm::gsym::LineTable::lookup</qualifiedname>
        <param>
          <type><ref refid="classllvm_1_1_data_extractor" kindref="compound">DataExtractor</ref> &amp;</type>
          <declname>Data</declname>
        </param>
