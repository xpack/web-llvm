        <definition>ImmutableSet llvm::ImmutableSet&lt; ValT, ValInfo &gt;::Factory::remove</definition>
        <argsstring>(ImmutableSet Old, value_type_ref V)</argsstring>
        <name>remove</name>
        <qualifiedname>llvm::ImmutableSet::Factory::remove</qualifiedname>
        <param>
          <type><ref refid="classllvm_1_1_immutable_set" kindref="compound">ImmutableSet</ref></type>
