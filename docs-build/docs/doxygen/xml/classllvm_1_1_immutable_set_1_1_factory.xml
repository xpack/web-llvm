      <memberdef kind="function" id="classllvm_1_1_immutable_set_1_1_factory_1afbc2f64a137fe78f0be7a6b1254bd42d" prot="public" static="no" nodiscard="yes" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type><ref refid="classllvm_1_1_immutable_set" kindref="compound">ImmutableSet</ref></type>
        <definition>ImmutableSet llvm::ImmutableSet&lt; ValT, ValInfo &gt;::Factory::add</definition>
        <argsstring>(ImmutableSet Old, value_type_ref V)</argsstring>
        <name>add</name>
        <qualifiedname>llvm::ImmutableSet::Factory::add</qualifiedname>
        <param>
          <type><ref refid="classllvm_1_1_immutable_set" kindref="compound">ImmutableSet</ref></type>
          <declname>Old</declname>
        </param>
        <param>
          <type><ref refid="classllvm_1_1_immutable_set_1af9d4d557fa1ad307d13311d54f960392" kindref="member">value_type_ref</ref></type>
          <declname>V</declname>
        </param>
        <briefdescription>
<para>add - Creates a new immutable set that contains all of the values of the original set with the addition of the specified value. </para>
        </briefdescription>
        <detaileddescription>
<para>If the original set already included the value, then the original set is returned and no memory is allocated. The time and space complexity of this operation is logarithmic in the size of the original set. The memory allocated to represent the set is released when the factory object that created the set is destroyed. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
