        <type><ref refid="classllvm_1_1_small_priority_worklist" kindref="compound">SmallPriorityWorklist</ref>&lt; <ref refid="classllvm_1_1_lazy_call_graph_1_1_s_c_c" kindref="compound">LazyCallGraph::SCC</ref> *, 1 &gt; &amp;</type>
