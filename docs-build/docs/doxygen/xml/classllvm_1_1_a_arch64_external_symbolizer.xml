        <definition>bool AArch64ExternalSymbolizer::tryAddingSymbolicOperand</definition>
        <argsstring>(MCInst &amp;MI, raw_ostream &amp;CommentStream, int64_t Value, uint64_t Address, bool IsBranch, uint64_t Offset, uint64_t OpSize, uint64_t InstSize) override</argsstring>
        <name>tryAddingSymbolicOperand</name>
